# Copie para .env (cp .env.example .env) e TROQUE os segredos antes de publicar.
# O docker compose le este arquivo sozinho; nada de segredo fica no codigo.

# ---- Seguranca do gateway (obrigatorias) ----
JWT_SEGREDO=troque-este-segredo-por-um-valor-longo-e-aleatorio
GATEWAY_USUARIO=admin
GATEWAY_SENHA=troque-esta-senha
JWT_EXPIRACAO_MINUTOS=60
RATE_LIMIT_POR_MINUTO=30

# ---- RabbitMQ (obrigatorias; use so letras, numeros, - e _ : vao numa URL) ----
RABBITMQ_USUARIO=plataforma
RABBITMQ_SENHA=troque-esta-senha-do-broker

# ---- Resiliencia do gateway ----
TIMEOUT_SERVICOS=5
TIMEOUT_GERACAO=30
TENTATIVAS_SERVICOS=3
ESPERA_BASE_SEGUNDOS=0.5
CB_LIMITE_FALHAS=5
CB_ESPERA_SEGUNDOS=30

# ---- Retencao (LGPD): resultados de inferencia expiram no Redis ----
RESULTADO_TTL_SEGUNDOS=86400

# ---- LLM da geracao: vazio = MODO SIMULADO (offline) ----
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODELO=gpt-4o-mini

# ---- Indice vetorial: vazio = arquivo no volume; com URL = guardado no Redis ----
# (no Railway/Render e obrigatorio usar o Redis; veja deploy/INSTRUCOES.md)
INDICE_REDIS_URL=

{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "inferencia/Dockerfile",
    "watchPatterns": [
      "inferencia/**",
      "comum/**",
      "proto/**"
    ]
  },
  "deploy": {
    "startCommand": "python servidor_grpc.py",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

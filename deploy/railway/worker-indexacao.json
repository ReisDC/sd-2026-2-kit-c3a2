{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "ingestion-service/Dockerfile",
    "watchPatterns": [
      "ingestion-service/**",
      "comum/**"
    ]
  },
  "deploy": {
    "startCommand": "python worker_indexacao.py",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

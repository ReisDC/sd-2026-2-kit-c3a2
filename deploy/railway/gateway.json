{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "gateway/Dockerfile",
    "watchPatterns": [
      "gateway/**",
      "comum/**",
      "proto/**"
    ]
  },
  "deploy": {
    "startCommand": "uvicorn app:app --host 0.0.0.0 --port 8000 --no-access-log --proxy-headers --forwarded-allow-ips *",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/saude",
    "healthcheckTimeout": 120
  }
}
